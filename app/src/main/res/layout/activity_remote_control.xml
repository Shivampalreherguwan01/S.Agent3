<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050B14"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👑 S.Agent"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Disconnect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Connection Status -->
    <TextView
        android:id="@+id/tvConnStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 Connected to : "
        android:textColor="#4CAF50"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <!-- Screen Share Active Banner -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="🖥️ Screen Sharing Active"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:background="#3F51B5"
        android:layout_marginBottom="12dp"/>

    <!-- Quick Control Buttons -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ Quick Control"
        android:textColor="#00E5FF"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="8dp">
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="🏠\nHome" android:layout_marginEnd="6dp" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="↩️\nBack" android:layout_marginEnd="6dp" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="☰\nMenu" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="8dp">
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="⏻\nPower" android:layout_marginEnd="6dp" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="🔊\nVol +" android:layout_marginEnd="6dp" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="🔉\nVol -" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="☀️\nBright +" android:layout_marginEnd="6dp" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="🌙\nBright -" android:layout_marginEnd="6dp" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
        <Button android:layout_width="0dp" android:layout_height="65dp" android:layout_weight="1" android:text="📸\nScreenshot" android:backgroundTint="#0D1B2A" android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
