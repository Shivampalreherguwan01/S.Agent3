<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050B18"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👑 S.Agent\nRemote Control"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Disconnect"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Connection Status -->
    <TextView
        android:id="@+id/tvConnStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 Connected to : "
        android:textColor="#22C55E"
        android:textSize="12sp"
        android:layout_marginBottom="8dp"/>

    <!-- Live Screen View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B162C"
        android:layout_marginBottom="8dp">
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remoteVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Control Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:layout_marginBottom="8dp">

        <Button android:id="@+id/btnHome" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="🏠" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="↩️" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnMenu" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="☰" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnPower" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="⏻" android:backgroundTint="#0B162C" android:textColor="#DC2626"/>

        <Button android:id="@+id/btnVolUp" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="🔊+" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnVolDown" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="🔊-" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnBrightUp" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="☀️+" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
        <Button android:id="@+id/btnBrightDown" android:layout_width="0dp" android:layout_height="50dp" android:layout_columnWeight="1" android:text="🌙-" android:backgroundTint="#0B162C" android:textColor="#FFFFFF"/>
    </GridLayout>
</LinearLayout>
